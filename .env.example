TELEGRAM_BOT_TOKEN=        # токен Telegram-бота (BotFather → /newbot)
OPENROUTER_API_KEY=        # API-ключ OpenRouter (openrouter.ai/keys)
LLM_MODEL_NAME=meta-llama/llama-3.3-70b-instruct  # модель OpenRouter

FIGMA_TOKEN=               # Figma Personal Access Token (Settings → Security → Personal access tokens)

GITHUB_TOKEN=              # GitHub Personal Access Token (Settings → Developer settings → PAT)

JIRA_EMAIL=                # email учётной записи Jira
JIRA_API_TOKEN=            # Jira API token (id.atlassian.com → Security → API tokens)

WHISPER_MODEL_NAME=base    # faster-whisper: tiny / base / small / medium / large-v3
WHISPER_DEVICE=auto        # auto / cpu / cuda
