{
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace-orchestrator",
      "model": {
        "primary": "anthropic/claude-sonnet-4-6"
      },
      "timeoutSeconds": 300
    },
    "list": [
      {
        "id": "orchestrator",
        "default": true,
        "workspace": "/home/node/.openclaw/workspace-orchestrator"
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "open",
      "mediaMaxMb": 50,
      "streaming": {
        "mode": "off"
      },
      "errorPolicy": "silent"
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        }
      }
    }
  },
  "tools": {
    "exec": {
      "security": "full"
    }
  },
  "gateway": {
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_AUTH_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "plugins": {
    "entries": {
      "anthropic": {
        "enabled": true
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.5.4",
    "lastTouchedAt": "2026-05-05T19:28:15.164Z"
  }
}
